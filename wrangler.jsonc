{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxyv",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3766274b-4b6a-4b3c-ab32-e499d9f3f184","database_name": "nova-proxyv" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "80d74a08264a435ca6078dac81f820d8" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
